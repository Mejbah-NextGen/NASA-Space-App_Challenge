# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DEMO_MODE=true

# Development uses SQLite when DATABASE_URL is empty.
# Production example: postgresql://user:password@host:5432/farm_time_machine
DATABASE_URL=
POSTGRES_SSLMODE=prefer

# Development defaults to process-local cache. Production must use a shared
# atomic backend such as Django's RedisCache.
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=farm-time-machine
CACHE_KEY_PREFIX=farm-time-machine

# Backend weather integration. Keep false for clearly labeled local demo data.
WEATHER_LIVE_ENABLED=false
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

# Optional OpenAI-compatible server-side chat provider.
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=
AI_RATE_LIMIT_PER_MINUTE=10

# Email. Console backend is the development default.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Farm Time Machine <noreply@example.com>
# Temporarily disabled. Set true when signup email verification is ready to launch.
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_MAX_AGE=86400

# Production security
SECURE_SSL_REDIRECT=true
TRUST_X_FORWARDED_PROTO=false
TRUST_X_FORWARDED_FOR=false
LOGIN_RATE_LIMIT=10
SUPPORT_RATE_LIMIT_PER_10_MINUTES=5
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO
